{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Run MazeApp",
            "request": "launch",
            "mainClass": "MazeApp",
            "vmArgs": "--module-path \"${workspaceFolder}/javafx-sdk-21.0.8/lib\" --add-modules javafx.controls,javafx.fxml",
            "preLaunchTask": "Compile MazeApp (JavaFX 21)",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ]
}

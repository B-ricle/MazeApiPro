{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile MazeApp (JavaFX 21)",
            "type": "shell",
            "command": "javac",
            "args": [
                "--module-path",
                "${workspaceFolder}/javafx-sdk-21.0.8/lib",
                "--add-modules",
                "javafx.controls,javafx.fxml",
                "-d",
                "bin",
                "**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$javac"
            ]
        }
    ]
}
